# Copy to .env and fill in. Never commit .env.

# Your desktop, from the challenge card in /evento.
DESKTOP_WS_URL=wss://your-desktop.example/websockify
DESKTOP_PASSWORD=
# Bearer token for the desktop's POST /__reset and POST /__check.
DESKTOP_TOKEN=

# Bearer token that callers of our agent send to it.
TEAM_TOKEN=

OPENROUTER_API_KEY=
